global proc shelf_ModTools () {
    global string $gBuffStr;
    global string $gBuffStr0;
    global string $gBuffStr1;


    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "ModTools" 
        -enableBackground 0
        -backgroundColor 0 0 0 
        -highlightColor 0.321569 0.521569 0.65098 
        -align "center" 
        -label "ModTools" 
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont" 
        -overlayLabelColor 0.8 0.8 0.8 
        -overlayLabelBackColor 0 0 0 0.5 
        -image "C:/NexusTools/icons/ModTools.png" 
        -image1 "C:/NexusTools/icons/ModTools.png" 
        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "\ntry:\n    import phoenix_panel\n    phoenix_panel.open_phoenix_panel()\nexcept ImportError:\n    import maya.cmds as cmds\n    cmds.warning(\n        \"PhoenixPanel: couldn't import the 'phoenix_panel' package. \"\n        \"Make sure its folder is inside a location on Maya's Python path \"\n        \"(e.g. your scripts folder) and that the folder is named \"\n        \"exactly 'phoenix_panel'.\"\n    )\n" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
        -mi "Set KeyBind" ( "# ModTools - keybind setup\n# Run in Maya's Script Editor (Python tab). Opens a small window where you\n# press the shortcut you want for opening ModTools (ModPanel).\n\nimport maya.cmds as cmds\nimport maya.OpenMayaUI as omui\n\ntry:\n    from PySide6 import QtWidgets, QtCore, QtGui\n    from shiboken6 import wrapInstance\nexcept ImportError:\n    from PySide2 import QtWidgets, QtCore, QtGui\n    from shiboken2 import wrapInstance\n\nRUNTIME_CMD = \"ModToolsOpenPanel\"\nNAME_CMD = \"ModToolsOpenPanelNameCommand\"\nNEXUS_SET = \"NexusPreset\"\nDEFAULT_SET = \"Maya_Default\"\nOPTVAR = \"ModToolsHotkey\"   # last assigned shortcut, \"key|ctl|alt|sht\"\n\n_SPECIAL_KEYS = {\n    QtCore.Qt.Key_Up: \"Up\", QtCore.Qt.Key_Down: \"Down\",\n    QtCore.Qt.Key_Left: \"Left\", QtCore.Qt.Key_Right: \"Right\",\n    QtCore.Qt.Key_Home: \"Home\", QtCore.Qt.Key_End: \"End\",\n    QtCore.Qt.Key_PageUp: \"Page_Up\", QtCore.Qt.Key_PageDown: \"Page_Down\",\n    QtCore.Qt.Key_Insert: \"Insert\", QtCore.Qt.Key_Delete: \"Delete\",\n    QtCore.Qt.Key_Return: \"Return\", QtCore.Qt.Key_Enter: \"Enter\",\n    QtCore.Qt.Key_Space: \"Space\", QtCore.Qt.Key_Tab: \"Tab\",\n}\nfor _i in range(1, 13):\n    _SPECIAL_KEYS[getattr(QtCore.Qt, \"Key_F{}\".format(_i))] = \"F{}\".format(_i)\n\n_MODIFIER_KEYS = (QtCore.Qt.Key_Control, QtCore.Qt.Key_Shift,\n                  QtCore.Qt.Key_Alt, QtCore.Qt.Key_Meta)\n\n\n# --------------------------------------------------------------------------\n# Maya hotkey helpers\n# --------------------------------------------------------------------------\ndef _maya_window():\n    ptr = omui.MQtUtil.mainWindow()\n    return wrapInstance(int(ptr), QtWidgets.QWidget) if ptr else None\n\n\ndef ensure_hotkey_set():\n    \"\"\"Use the current hotkey set, unless it is Maya's locked default - then\n    create (once) and switch to NexusPreset, a copy of the default.\"\"\"\n    current = cmds.hotkeySet(q=True, current=True)\n    if current != DEFAULT_SET:\n        return current\n    if not cmds.hotkeySet(NEXUS_SET, exists=True):\n        cmds.hotkeySet(NEXUS_SET, source=DEFAULT_SET)\n    cmds.hotkeySet(NEXUS_SET, edit=True, current=True)\n    return NEXUS_SET\n\n\ndef ensure_commands():\n    \"\"\"Create/refresh the runtime command and name command that open ModTools.\"\"\"\n    code = \"import phoenix_panel\\nphoenix_panel.open_phoenix_panel()\"\n    if cmds.runTimeCommand(RUNTIME_CMD, exists=True):\n        cmds.runTimeCommand(RUNTIME_CMD, edit=True, command=code,\n                            commandLanguage=\"python\")\n    else:\n        cmds.runTimeCommand(RUNTIME_CMD, annotation=\"Open ModTools (ModPanel)\",\n                            category=\"Custom Scripts.ModTools\",\n                            command=code, commandLanguage=\"python\")\n    for i in range(1, (cmds.assignCommand(q=True, numElements=True) or 0) + 1):\n        if cmds.assignCommand(i, q=True, name=True) == NAME_CMD:\n            return NAME_CMD\n    return cmds.nameCommand(NAME_CMD, annotation=\"Open ModTools (ModPanel)\",\n                            sourceType=\"mel\", command=RUNTIME_CMD)\n\n\ndef _flags(ctl, alt, sht):\n    return dict(ctrlModifier=bool(ctl), altModifier=bool(alt),\n                shiftModifier=bool(sht))\n\n\ndef current_assignment(key, ctl, alt, sht):\n    \"\"\"Return (name_command, readable_description) bound to this shortcut,\n    or (None, None).\"\"\"\n    try:\n        name = cmds.hotkey(key, q=True, name=True, **_flags(ctl, alt, sht))\n    except Exception:\n        name = None\n    if not name:\n        return None, None\n    desc = None\n    try:\n        desc = cmds.hotkeyCheck(keyString=key, ctl=bool(ctl), alt=bool(alt))\n    except Exception:\n        pass\n    if not desc:\n        try:\n            idx = [cmds.assignCommand(i, q=True, name=True)\n                   for i in range(1, (cmds.assignCommand(q=True, numElements=True) or 0) + 1)]\n            if name in idx:\n                desc = cmds.assignCommand(idx.index(name) + 1, q=True, annotation=True)\n        except Exception:\n            pass\n    return name, (desc or name)\n\n\ndef assign(key, ctl, alt, sht):\n    hk_set = ensure_hotkey_set()\n    name_cmd = ensure_commands()\n    # Clear the previous ModTools shortcut so only one stays active.\n    old = cmds.optionVar(q=OPTVAR) if cmds.optionVar(exists=OPTVAR) else \"\"\n    if old:\n        try:\n            ok, oc, oa, os_ = old.split(\"|\")\n            if (ok, oc, oa, os_) != (key, str(int(ctl)), str(int(alt)), str(int(sht))):\n                prev, _ = current_assignment(ok, int(oc), int(oa), int(os_))\n                if prev == name_cmd:\n                    cmds.hotkey(keyShortcut=ok, name=\"\", **_flags(int(oc), int(oa), int(os_)))\n        except Exception:\n            pass\n    cmds.hotkey(keyShortcut=key, name=name_cmd, **_flags(ctl, alt, sht))\n    cmds.optionVar(sv=(OPTVAR, \"{}|{}|{}|{}\".format(key, int(ctl), int(alt), int(sht))))\n    cmds.savePrefs(hotkeys=True)\n    return hk_set\n\n\ndef describe(key, ctl, alt, sht):\n    parts = []\n    if ctl:\n        parts.append(\"Ctrl\")\n    if alt:\n        parts.append(\"Alt\")\n    if sht:\n        parts.append(\"Shift\")\n    shown = key.upper() if len(key) == 1 else key.replace(\"_\", \" \")\n    if len(key) == 1 and key.isalpha() and key.isupper():\n        parts.append(\"Shift\")\n    parts.append(shown)\n    return \"+\".join(parts)\n\n\n# --------------------------------------------------------------------------\n# UI\n# --------------------------------------------------------------------------\nclass _KeyCapture(QtWidgets.QLineEdit):\n    \"\"\"Read-only field that records the next key combination pressed.\n    Backspace or Escape clears it.\"\"\"\n    changed = QtCore.Signal()\n\n    def __init__(self, parent=None):\n        super(_KeyCapture, self).__init__(parent)\n        self.setReadOnly(True)\n        self.setPlaceholderText(\"Click here, then press your shortcut\")\n        self.combo = None   # (maya_key, ctl, alt, sht)\n\n    def clear_combo(self):\n        self.combo = None\n        self.clear()\n        self.changed.emit()\n\n    def keyPressEvent(self, event):\n        key = event.key()\n        if key in _MODIFIER_KEYS:\n            return\n        if key in (QtCore.Qt.Key_Backspace, QtCore.Qt.Key_Escape):\n            self.clear_combo()\n            return\n        mods = event.modifiers()\n        ctl = bool(mods & QtCore.Qt.ControlModifier)\n        alt = bool(mods & QtCore.Qt.AltModifier)\n        sht = bool(mods & QtCore.Qt.ShiftModifier)\n\n        if key in _SPECIAL_KEYS:\n            maya_key = _SPECIAL_KEYS[key]\n        elif QtCore.Qt.Key_A <= key <= QtCore.Qt.Key_Z:\n            # Maya expresses Shift+letter as the uppercase letter.\n            maya_key = chr(key).upper() if sht else chr(key).lower()\n            sht = False\n        else:\n            text = QtGui.QKeySequence(key).toString()\n            if len(text) != 1:\n                return\n            maya_key = text\n            sht = False   # the typed character already includes Shift\n\n        self.combo = (maya_key, ctl, alt, sht)\n        self.setText(describe(maya_key, ctl, alt, sht))\n        self.changed.emit()\n\n\nclass ModToolsKeybindWindow(QtWidgets.QDialog):\n    def __init__(self, parent=None):\n        super(ModToolsKeybindWindow, self).__init__(parent or _maya_window())\n        self.setWindowTitle(\"ModTools Keybind\")\n        self.setWindowFlags(self.windowFlags() | QtCore.Qt.Tool)\n        self.setMinimumWidth(380)\n        self.setStyleSheet(\"\"\"\n            QDialog { background:#000000; }\n            QLabel { color:#d0d0d0; font-size:11px; }\n            QLabel#Title { color:#f2f2f2; font-size:15px; font-weight:600; }\n            QLabel#Beta { color:#f0a500; font-size:10px; }\n            QLabel#Hint { color:#898989; font-size:10px; }\n            QLineEdit { background:#050505; color:#f2f2f2; border:1px solid #383838;\n                        border-radius:4px; padding:8px; font-size:13px; }\n            QLineEdit:focus { border-color:#46b6ff; }\n            QPushButton { background:#0c0c0c; color:#bbbbbb; border:1px solid #484848;\n                          border-radius:4px; padding:6px 14px; font-size:11px; }\n            QPushButton:hover { background:#141414; color:#ffffff; border-color:#888888; }\n            QPushButton#Primary { background:#030b10; color:#46b6ff; border-color:#46b6ff; }\n            QPushButton#Primary:hover { background:#081d2b; color:#9bddff; border-color:#7bceff; }\n            QPushButton:disabled { color:#5a5a5a; border-color:#303030; }\n        \"\"\")\n\n        lay = QtWidgets.QVBoxLayout(self)\n        lay.setContentsMargins(18, 16, 18, 16)\n        lay.setSpacing(8)\n\n        title = QtWidgets.QLabel(\"Keybind: ModTools opening\")\n        title.setObjectName(\"Title\")\n        lay.addWidget(title)\n\n        self.current_lbl = QtWidgets.QLabel()\n        lay.addWidget(self.current_lbl)\n\n        lay.addWidget(QtWidgets.QLabel(\"Press your desired shortcut:\"))\n        self.capture = _KeyCapture()\n        self.capture.changed.connect(self._on_changed)\n        lay.addWidget(self.capture)\n\n        hint = QtWidgets.QLabel(\"Backspace or Esc clears the field.\")\n        hint.setObjectName(\"Hint\")\n        lay.addWidget(hint)\n\n        beta = QtWidgets.QLabel(\n            \"Beta: single-key shortcuts (like D, M or N) are supported \"\n            \"but still in beta.\")\n        beta.setObjectName(\"Beta\")\n        beta.setWordWrap(True)\n        lay.addWidget(beta)\n\n        self.set_lbl = QtWidgets.QLabel()\n        self.set_lbl.setObjectName(\"Hint\")\n        self.set_lbl.setWordWrap(True)\n        lay.addWidget(self.set_lbl)\n\n        row = QtWidgets.QHBoxLayout()\n        row.addStretch(1)\n        self.apply_btn = QtWidgets.QPushButton(\"Apply\")\n        self.apply_btn.setObjectName(\"Primary\")\n        self.apply_btn.setEnabled(False)\n        self.apply_btn.clicked.connect(self._apply)\n        close_btn = QtWidgets.QPushButton(\"Close\")\n        close_btn.clicked.connect(self.close)\n        row.addWidget(self.apply_btn)\n        row.addWidget(close_btn)\n        lay.addLayout(row)\n\n        self._refresh_info()\n        self.capture.setFocus()\n\n    def _refresh_info(self):\n        shortcut = \"none\"\n        if cmds.optionVar(exists=OPTVAR):\n            try:\n                k, c, a, s = cmds.optionVar(q=OPTVAR).split(\"|\")\n                shortcut = describe(k, int(c), int(a), int(s))\n            except Exception:\n                pass\n        self.current_lbl.setText(\"Current shortcut: \" + shortcut)\n        current = cmds.hotkeySet(q=True, current=True)\n        if current == DEFAULT_SET:\n            note = (\"Hotkey set: {} (locked) - a new set '{}' will be created \"\n                    \"and used.\".format(DEFAULT_SET, NEXUS_SET))\n        else:\n            note = \"Hotkey set: {}\".format(current)\n        self.set_lbl.setText(note)\n\n    def _on_changed(self):\n        self.apply_btn.setEnabled(self.capture.combo is not None)\n\n    def _apply(self):\n        combo = self.capture.combo\n        if combo is None:\n            return\n        key, ctl, alt, sht = combo\n        shortcut = describe(key, ctl, alt, sht)\n        try:\n            ensure_hotkey_set()\n            name_cmd = ensure_commands()\n            existing, desc = current_assignment(key, ctl, alt, sht)\n            if existing and existing != name_cmd:\n                answer = QtWidgets.QMessageBox.question(\n                    self, \"Shortcut in use\",\n                    \"{} is attached to:\\n\\n    {}\\n\\nDo you want to override it?\".format(\n                        shortcut, desc),\n                    QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,\n                    QtWidgets.QMessageBox.No)\n                if answer != QtWidgets.QMessageBox.Yes:\n                    return\n            hk_set = assign(key, ctl, alt, sht)\n        except Exception as e:\n            QtWidgets.QMessageBox.warning(self, \"ModTools Keybind\",\n                                          \"Could not set the shortcut:\\n{}\".format(e))\n            return\n        self._refresh_info()\n        cmds.inViewMessage(\n            amg=\"ModTools opens with <hl>{}</hl>  (hotkey set: {})\".format(shortcut, hk_set),\n            pos=\"midCenter\", fade=True)\n\n\ndef show_modtools_keybind():\n    global _MODTOOLS_KEYBIND_WIN\n    try:\n        _MODTOOLS_KEYBIND_WIN.close()\n        _MODTOOLS_KEYBIND_WIN.deleteLater()\n    except Exception:\n        pass\n    _MODTOOLS_KEYBIND_WIN = ModToolsKeybindWindow()\n    _MODTOOLS_KEYBIND_WIN.show()\n    _MODTOOLS_KEYBIND_WIN.raise_()\n    _MODTOOLS_KEYBIND_WIN.activateWindow()\n    return _MODTOOLS_KEYBIND_WIN\n\n\nshow_modtools_keybind()" )
        -mip 0
        -mi "Load at StartUp" ( "# ModTools - userSetup.py installer\n# Run once in Maya's Script Editor (Python tab).\n# Appends the ModPanel loader block to the end of userSetup.py (creates the\n# file if missing). The original file is backed up to userSetup.bak first.\n\nimport os\nimport shutil\nimport time\n\nimport maya.cmds as cmds\n\nSTART_MARK = \"# ModToolsStart\"\nEND_MARK = \"#ModToolsEnd\"\nBLOCK = \"\"\"# ModToolsStart\ntry:\n    from phoenix_panel import loader\n    loader.load()\nexcept Exception as e:\n    print(\"ModPanel loader error: {}\".format(e))\n#ModToolsEnd\n\"\"\"\n\n\ndef install_modtools_usersetup():\n    scripts_dir = cmds.internalVar(userScriptDir=True)\n    if not os.path.isdir(scripts_dir):\n        os.makedirs(scripts_dir)\n    path = os.path.join(scripts_dir, \"userSetup.py\")\n\n    existing = \"\"\n    if os.path.exists(path):\n        with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            existing = f.read()\n\n    if START_MARK in existing:\n        msg = \"ModTools is already in userSetup.py - nothing changed.\"\n        print(msg + \"\\n  \" + path)\n        cmds.inViewMessage(amg=msg, pos=\"midCenter\", fade=True)\n        return path\n\n    backup = None\n    if os.path.exists(path):\n        backup = os.path.join(scripts_dir, \"userSetup.bak\")\n        if os.path.exists(backup):\n            # Never overwrite an earlier backup.\n            backup = os.path.join(\n                scripts_dir, \"userSetup_{}.bak\".format(time.strftime(\"%Y%m%d_%H%M%S\")))\n        shutil.copy2(path, backup)\n\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        if existing and not existing.endswith(\"\\n\"):\n            f.write(\"\\n\")\n        if existing:\n            f.write(\"\\n\")\n        f.write(BLOCK)\n\n    print(\"ModTools added to: \" + path)\n    if backup:\n        print(\"Original backed up to: \" + backup)\n    else:\n        print(\"userSetup.py did not exist - created it.\")\n    cmds.inViewMessage(amg=\"ModTools added to userSetup.py. Restart Maya to load it.\",\n                       pos=\"midCenter\", fade=True)\n    return path\n\n\ninstall_modtools_usersetup()" )
        -mip 1
    ;

} 
